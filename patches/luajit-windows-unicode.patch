+/* Runtime paths are UTF-8, independent of the process ANSI code page. */
+static wchar_t *win_utf8path(const char *path)
+{
+  int count = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, NULL, 0);
+  wchar_t *wide;
+  DWORD err;
+  int i;
+  if (!count) return NULL;
+  wide = (wchar_t *)malloc((size_t)count * sizeof(wchar_t));
+  if (!wide) { SetLastError(ERROR_NOT_ENOUGH_MEMORY); return NULL; }
+  if (!MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, wide, count)) {
+    err = GetLastError();
+    free(wide);
+    SetLastError(err);
+    return NULL;
+  }
+  /* The Windows loader requires backslashes, including for dependency search. */
+  for (i = 0; i < count; i++) if (wide[i] == L'/') wide[i] = L'\\';
+  return wide;
+}
