+  count = wcslen(wide);
+#if LJ_TARGET_UWP
+  lib = LoadPackagedLibrary(wide, 0);
+#else
+  {
+    DWORD flags = LOAD_LIBRARY_SEARCH_DEFAULT_DIRS;
+    /* An absolute library path also owns its adjacent dependencies. */
+    if ((count >= 3 && wide[1] == L':' && (wide[2] == L'\\' || wide[2] == L'/')) ||
+        (count >= 2 && wide[0] == L'\\' && wide[1] == L'\\'))
+      flags |= LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR;
+    lib = LoadLibraryExW(wide, NULL, flags);
