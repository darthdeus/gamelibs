 static int readable(const char *filename)
 {
+#if LJ_TARGET_WINDOWS
+  wchar_t *wide = win_utf8path(filename);
+  FILE *f;
+  if (!wide) return 0;
+  f = _wfopen(wide, L"r");
+  free(wide);
+#else
   FILE *f = fopen(filename, "r");  /* try to open file */
+#endif
   if (f == NULL) return 0;  /* open failed */
   fclose(f);
   return 1;
