+/* The snapshot is O(1), independent of trace population. */
+LUA_API int luaJIT_health_read(lua_State *L, uint32_t version, void *out, size_t size)
+{
+  jit_State *J;
+  luaJIT_Health *h;
+  uint64_t gap;
+  if (!L || version != LUAJIT_HEALTH_VERSION || size != sizeof(luaJIT_Health) || !out)
+    return 0;
+  J = L2J(L); h = &J->health;
+  h->version = LUAJIT_HEALTH_VERSION; h->size = sizeof(*h);
+  h->capabilities = LUAJIT_HEALTH_COUNTERS | LUAJIT_HEALTH_COALESCING | LUAJIT_HEALTH_VMCATEGORY;
+  memcpy(h->build_id, "a4c064539ea931274d407e1249b4bb575424a0f4+rock-health-1", sizeof("a4c064539ea931274d407e1249b4bb575424a0f4+rock-health-1"));
+  gap = J->mcarea ? (uint64_t)((char *)J->mctop - (char *)J->mcbot) : 0;
+  h->arena_bytes = J->szallmcarea;
+  h->code_current_free_bytes = gap;
+  h->code_reserved_bytes = J->health_reserved;
+  h->arena_occupied_bytes = h->arena_bytes - J->health_retired_free - gap;
+  memcpy(out, h, sizeof(*h));
+  return 1;
+}
+
+LUA_API int luaJIT_health_configure(lua_State *L, uint32_t version, uint32_t flags)
+{
+  jit_State *J;
+  if (!L || version != LUAJIT_HEALTH_VERSION || (flags & ~LUAJIT_HEALTH_COALESCING)) return 0;
+  J = L2J(L);
+  if (flags && !J->health_ring) {
+    J->health_ring = (luaJIT_HealthCoal *)calloc(LUAJIT_HEALTH_RING, sizeof(luaJIT_HealthCoal));
+    if (!J->health_ring) return 0;
+  }
+  J->health_flags = flags;
+  return 1;
+}
+
+LUA_API int luaJIT_health_coalescing(lua_State *L, uint32_t version, uint64_t first,
+                                   void *out, size_t stride, uint32_t capacity)
+{
+  jit_State *J;
+  uint64_t seq, next, oldest;
+  uint32_t n = 0;
+  if (!L || version != LUAJIT_HEALTH_VERSION || stride != sizeof(luaJIT_HealthCoal) ||
+      (capacity && !out)) return -1;
+  J = L2J(L); next = J->health.ring_next;
+  oldest = next > LUAJIT_HEALTH_RING ? next - LUAJIT_HEALTH_RING : 0;
+  seq = first > oldest ? first : oldest;
+  for (; seq < next && n < capacity; seq++, n++)
+    memcpy((char *)out+n*stride, &J->health_ring[seq % LUAJIT_HEALTH_RING], stride);
+  return (int)n;
+}
